# VITAIQ Enterprise Healthcare Environment Configuration

# Resend API Secret Key (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
VITE_RESEND_API_KEY=your_resend_api_key_here

# Sender Email Configuration
# Default testing sender for Resend (without custom domain): onboarding@resend.dev
# Once custom domain is verified in Resend, change sender to: noreply@vitalq.com
RESEND_SENDER_EMAIL=onboarding@resend.dev
VITE_SENDER_EMAIL=onboarding@resend.dev

# Backend Service Layer Toggle (true = mock local DB | false = REST API backend)
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://localhost:5000/api
